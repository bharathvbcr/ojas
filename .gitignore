# Core dumps & crash reports
/core
/core.[0-9]*
*.crash
*.ips
hs_err_pid*.log

# Fuzzing & mutation-testing working dirs
fuzz/artifacts/
fuzz/corpus/
mutants.out/
mutants.out.old/

# Cargo vendoring/output outside target dirs
/vendor/
*.rs.bk

# Imported from MLSystemsLab (2026-10-08): regenerable arch02 parity activations
# (python3 arch02/metal-native/scripts/export_goldens.py) and run outputs.
arch02/metal-native/golden/fwd/
arch02/metal-native/out/

# DevCouncil local state
.devcouncil/*
!/.devcouncil/
!.devcouncil/config.yaml

# Session scratch: logs, board dumps and other sessions' backups (kept out of git; see tools/a6/README.md)
backups/

# GitPulse and DevMap state
.gitpulse/
/.gitpulse/
.devmap/
/.devmap/

# Agent session reports belong in docs/reports/ (committed deliberately), never at the root
/BUILD_REPORT*
/WAVE_REPORT*
/*wave*report*
/*WAVE_REPORT*
/BRANCH_REPORT*
/AUDIT_REPORT*
/HANDOFF*

# Documentation scratch & guides
docs/guide/
site/guide/

# Rust compiler, incremental, & lane clutter
*.rcgu.o
ojas_cpu-*.rcgu.o
scratch/
tmp/

# Claude Code cloud sessions with one repository read this file
# and do not read ~/.claude/settings.json. Machine-local overrides
# stay in .claude/settings.local.json.
!.claude/
.claude/*
!.claude/settings.json
