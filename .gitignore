# Build targets (Cargo)
target/
/target
/target-*/
/target-*
target-*/
**/target/
*.rlib
*.rmeta

# Generated benchmark reference tensors (multi-GB; regenerate with the bench harness)
*.f32
bench/results/**/ref/
bench/results/**/ref/*.f32
bench/out/

# Go artifacts
*.test
*.out
coverage.out
go/coverage.out
go.work
go.work.sum
bin/
# Cargo binary sources, not build output (bin/ above hid ojas-cuda's rung0/runga).
!**/src/bin/

# Python artifacts & environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.ipynb_checkpoints/
.venv/
venv/
env/
dist/
build/
*.egg-info/

